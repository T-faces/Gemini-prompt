{
  "name": "enoproj",
  "version": "1.0.0",
  "description": "Frontend + Backend Gemini 2.5 Flash (Node.js + Vercel)",
  "main": "api/gemini.js",
  "type": "module",
  "scripts": {
    "dev": "vercel dev",
    "start": "node api/gemini.js",
    "build": "echo 'No build step required for static + Node API'"
  },
  "keywords": [
    "gemini",
    "google-genai",
    "ai",
    "vercel",
    "node",
    "api"
  ],
  "author": "enowap99",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.13.1",
    "express": "^5.1.0",
    "mongoose": "^8.8.0",
    "node-fetch": "^3.3.2",
    "formidable": "^3.5.1",
     "dotenv": "^16.4.5"
  },
  "engines": {
    "node": ">=18"
  },
  "vercel": {
    "builds": [
      { "src": "api/gemini.js", "use": "@vercel/node" },
      { "src": "public/**/*", "use": "@vercel/static" }
    ],
    "routes": [
      { "src": "/api/(.*)", "dest": "/api/gemini.js" },
      { "src": "/(.*)", "dest": "/public/index.html" }
    ]
  }
}
